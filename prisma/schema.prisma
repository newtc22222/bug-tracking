generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeedbackType {
  bug
  improvement
  feature
  question
}

enum FeedbackStatus {
  open
  in_progress
  resolved
  closed
}

enum FeedbackPriority {
  low
  medium
  high
}

enum FeedbackSource {
  manual
  public_form
  extension
  api
}

model Project {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  domain        String?         @unique
  repoUrl       String?
  webhookUrl    String?
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  feedbackItems FeedbackItem[]
  apiKeys       ProjectApiKey[]
}

model FeedbackItem {
  id                String                @id @default(cuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  type              FeedbackType
  status            FeedbackStatus        @default(open)
  priority          FeedbackPriority?
  source            FeedbackSource        @default(manual)
  reporterName      String?
  reporterEmail     String?
  pageUrl           String?
  browserInfo       String?
  screenshotDataUrl String?
  githubIssueUrl    String?
  githubIssueNumber Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  notes             FeedbackNote[]
  statusEvents      FeedbackStatusEvent[]

  @@index([projectId])
}

model FeedbackNote {
  id             String       @id @default(cuid())
  feedbackItemId String
  feedbackItem   FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)
  authorEmail    String
  body           String
  createdAt      DateTime     @default(now())

  @@index([feedbackItemId])
}

model FeedbackStatusEvent {
  id             String          @id @default(cuid())
  feedbackItemId String
  feedbackItem   FeedbackItem    @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)
  fromStatus     FeedbackStatus?
  toStatus       FeedbackStatus
  actorEmail     String
  createdAt      DateTime        @default(now())

  @@index([feedbackItemId])
}

model ProjectApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
