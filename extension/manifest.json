{
  "manifest_version": 3,
  "name": "Bug Tracking Feedback",
  "version": "0.2.0",
  "description": "Submit contextual bug reports with screenshots and diagnostics to a self-hosted Bug Tracking workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://your-bug-tracker-domain.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Send feedback",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
